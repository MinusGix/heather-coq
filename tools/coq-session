#!/usr/bin/env python3
"""A proof session that stays open: pay for a file's prefix once, then try
tactics against the goal as often as you like.

`coqc` on a scratch copy re-runs the `Require`s and every sentence before
the proof on each attempt.  This keeps one `coqtop` alive with the state
just before a line, runs what you send, shows the goals and rolls back.

Usage (from the repository root, inside `nix develop path:.`; the files a
session requires must be built, `make -j4 vos` is enough):

  tools/coq-session start FILE.v LINE [--vos]
      Load FILE's lines before LINE in the background and keep the state.
      LINE may also be a lemma's name: the session then stops just after
      that lemma's `Proof.` line.
  tools/coq-session try 'tac1. tac2.'      run, print output + goals, roll back
  tools/coq-session try -f script.v        the same, from a file ('-' = stdin)
  tools/coq-session step 'tac1.'           run and keep (moves the base state)
  tools/coq-session undo                   back to the state before the last step
  tools/coq-session goals                  Show.
  tools/coq-session stop

One session per repository (socket in .coq-session/); `--name N` on every
command for more.
"""
import argparse, os, re, socket, subprocess, sys, time, json, signal

ROOT = os.getcwd()
PROMPT = re.compile(rb'<prompt>\S* < (\d+) \|[^|]*\| (\d+) < </prompt>')


def project_args():
    args = []
    try:
        toks = open('_CoqProject').read().split('\n')
    except OSError:
        return ['-Q', 'theories', 'DeLaM']
    for line in toks:
        p = line.split()
        if not p or p[0].endswith('.v'):
            continue
        i = 0
        while i < len(p):
            if p[i] in ('-Q', '-R'):
                args += p[i:i + 3]; i += 3
            elif p[i] == '-arg':
                args.append(p[i + 1]); i += 2
            else:
                i += 1
    return args


class Top:
    def __init__(self, vos):
        cmd = ['coqtop', '-emacs'] + project_args()
        self.p = subprocess.Popen(cmd, stdin=subprocess.PIPE,
                                  stdout=subprocess.PIPE,
                                  stderr=subprocess.STDOUT, bufsize=0)
        self.n = 0
        self.state = 1
        self.state = self.run('')[1]

    def run(self, text):
        """Send sentences, then a sentinel; return (output, state id)."""
        self.n += 1
        mark = f'coq_session_mark_{self.n}'
        self.p.stdin.write((text + f'\nFail Check {mark}.\n').encode())
        self.p.stdin.flush()
        buf = b''
        want = mark.encode()
        while True:
            chunk = os.read(self.p.stdout.fileno(), 65536)
            if not chunk:
                raise RuntimeError('coqtop died:\n' + buf.decode(errors='replace'))
            buf += chunk
            i = buf.find(want)
            if i >= 0:
                ms = list(PROMPT.finditer(buf, i))
                if ms and ms[-1].end() == len(buf):
                    m = ms[-1]
                    break
        state = int(m.group(1))
        out = buf[:buf.rfind(b'The command has indeed failed', 0, buf.find(want))]
        out = PROMPT.sub(b'', out).decode(errors='replace')
        out = re.sub(r'<infomsg>|</infomsg>|<warning>|</warning>', '', out)
        out = re.sub(r'\n{3,}', '\n\n', out).strip()
        return out, state

    def back(self, state):
        self.run(f'BackTo {state}.')


def prefix_of(path, where):
    lines = open(path).read().split('\n')
    if where.isdigit():
        return '\n'.join(lines[:int(where) - 1])
    pat = re.compile(r'^\s*(Lemma|Theorem|Corollary|Fact|Remark|Proposition|Definition|Instance|Example)\s+'
                     + re.escape(where) + r'\b')
    for i, l in enumerate(lines):
        if pat.match(l):
            for j in range(i, len(lines)):
                if re.match(r'^\s*Proof\b.*\.\s*$', lines[j]):
                    return '\n'.join(lines[:j + 1])
            break
    sys.exit(f'no lemma {where} with a Proof. line in {path}')


def serve(sockpath, path, where, vos):
    t0 = time.time()
    top = Top(vos)
    out, base = top.run(prefix_of(path, where))
    load = time.time() - t0
    hist = []
    srv = socket.socket(socket.AF_UNIX)
    if os.path.exists(sockpath):
        os.unlink(sockpath)
    srv.bind(sockpath)
    srv.listen(1)
    errs = '\n'.join(l for l in out.split('\n') if l.strip())
    open(sockpath + '.ready', 'w').write(
        f'loaded {path} up to {where} in {load:.1f} s\n' +
        (errs[-3000:] + '\n' if 'Error' in errs else ''))
    while True:
        c, _ = srv.accept()
        data = b''
        while not data.endswith(b'\0'):
            d = c.recv(65536)
            if not d:
                break
            data += d
        req = json.loads(data[:-1].decode())
        t = time.time()
        try:
            if req['cmd'] == 'stop':
                c.sendall(b'stopped\n'); c.close(); break
            elif req['cmd'] == 'try':
                o, _ = top.run(req['text'])
                g, _ = top.run('Show.')
                top.back(base)
                res = o + '\n--- goals ---\n' + g
            elif req['cmd'] == 'step':
                hist.append(base)
                o, base = top.run(req['text'])
                g, base = top.run('Show.')
                res = o + '\n--- goals ---\n' + g
            elif req['cmd'] == 'undo':
                if hist:
                    base = hist.pop(); top.back(base)
                res, _ = top.run('Show.')
                _, base = top.run('')
            else:
                res, _ = top.run('Show.')
                top.back(base)
            res += f'\n[{time.time() - t:.2f} s]\n'
        except Exception as e:  # report, keep serving if coqtop lives
            res = f'session error: {e}\n'
        c.sendall(res.encode()); c.close()
    top.p.kill()
    for f in (sockpath, sockpath + '.ready'):
        if os.path.exists(f):
            os.unlink(f)


def ask(sockpath, req):
    s = socket.socket(socket.AF_UNIX)
    try:
        s.connect(sockpath)
    except OSError:
        sys.exit('no session: tools/coq-session start FILE.v LINE')
    s.sendall(json.dumps(req).encode() + b'\0')
    out = b''
    while True:
        d = s.recv(65536)
        if not d:
            break
        out += d
    sys.stdout.write(out.decode())


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--name', default='default')
    sub = ap.add_subparsers(dest='cmd', required=True)
    st = sub.add_parser('start'); st.add_argument('file'); st.add_argument('where')
    st.add_argument('--vos', action='store_true')
    st.add_argument('--foreground', action='store_true')
    for c in ('try', 'step'):
        p = sub.add_parser(c); p.add_argument('text', nargs='?'); p.add_argument('-f')
    for c in ('undo', 'goals', 'stop'):
        sub.add_parser(c)
    a = ap.parse_args()
    os.makedirs('.coq-session', exist_ok=True)
    sock = f'.coq-session/{a.name}.sock'
    if a.cmd == 'start':
        if os.path.exists(sock):
            ask(sock, {'cmd': 'stop'})
        if os.path.exists(sock + '.ready'):
            os.unlink(sock + '.ready')
        if not a.foreground and os.fork():
            while not os.path.exists(sock + '.ready'):
                time.sleep(0.2)
            sys.stdout.write(open(sock + '.ready').read())
            return
        if not a.foreground:
            os.setsid()
            fd = os.open(os.devnull, os.O_RDWR)
            for i in (0, 1, 2):
                os.dup2(fd, i)
        serve(sock, a.file, a.where, a.vos)
    elif a.cmd in ('try', 'step'):
        text = a.text
        if a.f:
            text = sys.stdin.read() if a.f == '-' else open(a.f).read()
        ask(sock, {'cmd': a.cmd, 'text': text})
    else:
        ask(sock, {'cmd': a.cmd})


if __name__ == '__main__':
    main()
